# ============================================================
# XAUUSD 量化交易系统 - 环境变量配置
# ============================================================
# 复制此文件为 .env 并按需修改:
#   cp .env.example .env
# 或直接设置系统环境变量

# ── LLM 配置（用于黄金快讯方向判断）────────────────────
# 如果不设，系统使用 data/llm_providers.json 中的配置
# 如果设了，环境变量优先级最高

# API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# API 地址（可选，默认 https://api.openai.com/v1）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称（可选，默认 gpt-4o-mini）
LLM_MODEL=deepseek-v4-flash

# 显示名称（可选，默认 "ENV Provider"）
LLM_NAME=My DeepSeek

# 类型（可选，默认 openai，支持 openai / ollama）
LLM_TYPE=openai

# ── 示例配置 ──────────────────────────────────────────
# DeepSeek:
#   LLM_API_KEY=sk-xxxxxxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# OpenAI:
#   LLM_API_KEY=sk-xxxxxxxxxxxx
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# 本地 Ollama:
#   LLM_API_KEY=
#   LLM_TYPE=ollama
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=qwen2.5:7b


# Smithery Registry API Key（可选，配置后 MCP 市场支持系统内搜索）
SMITHERY_API_KEY=
