{
  "// ════════════════════════ runtime_config.json · 四大类总览 ═══════════════════════": "本文件由 core/runtime_config.py 用 json.load 严格读取。所有 '//' 开头的键都是注释（引擎忽略、前端保存保留），可安全保留。",
  "// 文件结构（4 大类，顺序即阅读顺序）：": "一、公用设置（跨模式通用：新闻/语言/协调器 + 交易模式选择） → 二、实盘配置（仅实盘生效） → 三、纸面配置（仅纸面生效） → 四、策略配置（最后）。",
  "// 【极易配错】三种 max_positions 各管什么：": "① 顶层 max_positions = 实盘『全局总持仓』上限（纸面不读）。② paper_trading.max_positions = 纸面『每策略』上限。③ strategy_pool.<名>.max_positions = 单策略自身上限（优先级最高）。三者互不影响！",
  "// ╔══════════════════════════════════════════════════════════════════════════════╗": "",
  "// ║  一、公用设置 / COMMON（跨交易模式通用，放最前）                              ║": "",
  "// ╚══════════════════════════════════════════════════════════════════════════════╝": "",
  "// ★ 交易模式选择（实盘/纸面）：由下方【三、纸面配置】的 paper_trading.enabled 控制。": "true = 纸面模拟交易（当前值）；false = 实盘交易（此时【二、实盘配置】生效，【三、纸面配置】绝大部分被忽略）。切换后前端会提示重启引擎。",
  "// 【公用项范围说明】本文件仅含以下跨模式公用项：新闻过滤(news_*)、界面语言(language)、多策略协调器(coordinator)。": "MT4 连接配置(地址/端口/品种)与 AI Agent 配置(LLM/人设/技能/MCP)均为『独立配置体系』——前者前端为只读展示(硬编码 127.0.0.1:23232)，后者在独立 agent 配置中——均不在本文件。如需纳入本文件分类请另议。",
  "// ──── 新闻过滤（实盘/纸面通常均生效，属全局风控）────": "",
  "// news_filter_enabled：新闻过滤总开关；false=不在重大新闻前后限制交易。": "",
  "news_filter_enabled": true,
  "// news_before_minutes：新闻前禁交易（分钟）；重大新闻发布前多少分钟停止开仓。": "",
  "news_before_minutes": 120,
  "// news_after_minutes：新闻后禁交易（分钟）；重大新闻发布后多少分钟停止开仓。": "",
  "news_after_minutes": 120,
  "// news_impact_filter：过滤的新闻影响级别，如 High 仅高影响；High,Medium 高+中。": "",
  "news_impact_filter": "High",
  "// news_currency_filter：过滤的货币，如 USD 只针对美元相关新闻限交易。": "",
  "news_currency_filter": "USD",
  "// news_bias_enabled：新闻偏向分析开关；开启后依据多空偏向限制对应方向开仓。": "",
  "news_bias_enabled": true,
  "// news_bias_report_hours：偏向报告时间(UTC,逗号分隔)，如 '8,20'=每天08:00/20:00生成。": "",
  "news_bias_report_hours": "8,20",
  "// block_long_when_bias_bearish：偏空时禁多；偏向空头时禁止开多单。": "",
  "block_long_when_bias_bearish": false,
  "// block_short_when_bias_bullish：偏多时禁空；偏向多头时禁止开空单。": "",
  "block_short_when_bias_bullish": false,
  "// ──── 界面语言（公用）────": "",
  "// language：界面语言，如 'en-US' / 'zh-CN'。": "",
  "language": "en-US",
  "// ──── 多策略协调器（跨模式全局调度；enabled=false 时以下规则全不生效）────": "",
  "coordinator": {
    "// news_bias_di_gap": "偏向 DI 差值阈值：多空 DI 差值小于此值视为无明确偏向。",
    "news_bias_di_gap": 10,
    "// enabled": "协调器总开关；false 时以下所有规则不生效。",
    "enabled": true,
    "// m15_reverse_tp_enabled": "M15 反转止盈开关。",
    "m15_reverse_tp_enabled": false,
    "// m15_reverse_tp_sensitivity": "M15 反转止盈敏感度（0~1）。",
    "m15_reverse_tp_sensitivity": 0.5,
    "// mtf_resonance_enabled": "多周期共振：多时间周期方向共振才允许开仓。",
    "mtf_resonance_enabled": false,
    "// position_gate_enabled": "仓位闸门开关。",
    "position_gate_enabled": false,
    "// position_gate_lookback": "仓位闸门回看周期（M15）。",
    "position_gate_lookback": 60,
    "// position_gate_bottom": "仓位占比下限（如 0.1 = 10%）。",
    "position_gate_bottom": 0.1,
    "// position_gate_top": "仓位占比上限（如 0.9 = 90%）。",
    "position_gate_top": 0.9,
    "// rally_drop_enabled": "急涨急跌惩罚开关。",
    "rally_drop_enabled": false,
    "// rally_drop_lookback": "急涨急跌统计回看周期。",
    "rally_drop_lookback": 10,
    "// rally_drop_threshold": "急涨急跌触发阈值（%）。",
    "rally_drop_threshold": 1.5,
    "// di_gate_skip_threshold": "DI 超此阈值时跳过闸门。",
    "di_gate_skip_threshold": 50,
    "// rally_drop_adx_skip": "ADX 超此阈值时跳过急涨急跌惩罚。",
    "rally_drop_adx_skip": 50,
    "// profit_drawdown_enabled": "回撤止盈开关。",
    "profit_drawdown_enabled": true,
    "// profit_drawdown_pct": "盈利回撤达此比例止盈（如 0.4 = 40%）。",
    "profit_drawdown_pct": 0.4,
    "// profit_drawdown_min_peak_atr": "需峰值 ATR 达此倍数才触发回撤止盈。",
    "profit_drawdown_min_peak_atr": 0.5,
    "// position_gate_m30_lookback": "仓位闸门回看周期（M30）。",
    "position_gate_m30_lookback": 40
  },
  "// ║  二、实盘配置 / LIVE（仅 paper_trading.enabled=false 时生效；与纸面完全隔离）  ║": "",
  "// ⚠️ 当前 paper_trading.enabled=true（纸面模式），以下全部『暂不生效』，仅供切回实盘时参考。": "",
  "// ──── 【卡片1 · 仓位管理】全局手数 / 实盘总持仓 / 每策略持仓 ────": "",
  "// lot_size：全局下单手数（手），实盘策略共用；纸面模式被 paper_trading.lot_size 覆盖。": "",
  "lot_size": 0.01,
  "// max_positions：实盘『全局总持仓』上限——仅实盘读取。注意≠每策略上限！": "",
  "max_positions": 7,
  "// per_strategy_max_positions：每策略默认上限（兜底）；null=引擎内置默认(1)，被 strategy_pool 各策略 max_positions 覆盖。": "",
  "per_strategy_max_positions": 2,
  "// ──── 【卡片2 · 账户级止盈止损】SL/TP、滑点、冷却、安全锁、亏损限额 ────": "",
  "// stop_loss_pips：默认止损点数，新订单未指定止损时使用的全局默认。": "",
  "stop_loss_pips": 50,
  "// take_profit_pips：默认止盈点数，新订单未指定止盈时使用的全局默认。": "",
  "take_profit_pips": 100,
  "// slippage：下单允许的最大滑点（点）。": "",
  "slippage": 5,
  "// profit_exit_cooldown_hours：止盈后冷却（小时）；0=不冷却，盈利平仓后多久内不再开同策略新仓。": "",
  "profit_exit_cooldown_hours": 0,
  "// safety_lock_timeout_minutes：安全锁超时（分钟）；超此时长无心跳/无成交触发安全锁暂停交易。": "",
  "safety_lock_timeout_minutes": 400,
  "// per_strategy_realized_loss_amount：单策略绝对亏损限额（金额）；累计实现亏损超此值即封锁该策略。": "",
  "per_strategy_realized_loss_amount": 30,
  "// max_daily_loss_pct：账户单日最大亏损百分比；当日浮亏+实亏达此比例触发全局日内止损。": "",
  "max_daily_loss_pct": 12,
  "// ──── 【卡片3 · 单策略风控】浮动亏损、连亏、急速离场 ────": "",
  "// floating_loss_warn_pct：浮动亏损预警线（%）；总浮亏达此比例仅预警，不封锁。": "",
  "floating_loss_warn_pct": 5,
  "// floating_loss_block_pct：浮动亏损封锁线（%）；总浮亏达此比例封锁新开仓（不强制平已有仓）。": "",
  "floating_loss_block_pct": 10,
  "// per_strategy_realized_loss_pct：单策略实现亏损封锁线（%）；累计实现亏损达此比例封锁该策略 N 小时。": "",
  "per_strategy_realized_loss_pct": 5,
  "// per_strategy_loss_block_hours：策略亏损封锁时长（小时）；触发后该策略被封锁的时长。": "",
  "per_strategy_loss_block_hours": 12,
  "// max_rapid_exits：短时间内最大离场次数；窗口内超此值判异常急速离场。": "",
  "max_rapid_exits": 3,
  "// rapid_exit_window_seconds：急速离场统计窗口（秒）。": "",
  "rapid_exit_window_seconds": 300,
  "// rapid_exit_cooldown_seconds：急速离场后冷却（秒）。": "",
  "rapid_exit_cooldown_seconds": 7200,
  "// max_consecutive_losses：最大连续亏损次数；连续亏损达此次数封锁策略。": "",
  "max_consecutive_losses": 3,
  "// consecutive_loss_cooldown_hours：连亏后冷却（小时）。": "",
  "consecutive_loss_cooldown_hours": 4,
